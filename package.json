{
  "name": "streamdeck-homeassistant-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-editor": "vite build --config vite.editor.config.js",
    "build-editor-dev": "vite build --config vite.editor.config.js --mode development --sourcemap inline --minify false",
    "validate": "streamdeck validate --no-update-check ./build/de.perdoctus.streamdeck.homeassistant.sdPlugin",
    "build-dev": "vite build --mode development --sourcemap inline --minify false",
    "bundle": "streamdeck bundle -f --no-update-check ./build/de.perdoctus.streamdeck.homeassistant.sdPlugin",
    "bundle-dev": "vite build --mode development --sourcemap inline --minify false && streamdeck bundle -f -o ./build --no-update-check ./build/de.perdoctus.streamdeck.homeassistant.sdPlugin",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@iconify/utils": "^3.1.7",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "home-assistant-js-websocket": "^9.7.1",
    "js-yaml": "5.5.0",
    "nunjucks": "3.2.4",
    "vue": "^3.5.44"
  },
  "overrides": {
    "@modyfi/vite-plugin-yaml": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@eslint/js": "^10.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
